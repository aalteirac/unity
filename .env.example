PORT=3001
# mock | dry-run | live-test. live-test creates real listings for ONE allowlisted account.
SHARING_MODE=mock
NATIVE_APP_PACKAGE=UNITY_ANALYTICS_PACKAGE
DATA_SOURCE=UNITY_DATA.PUBLIC.EVENTS
DATA_UNITY_ID_COLUMN=UNITY_ID
DATA_OUTPUT_COLUMNS=PROJECT_NAME,EVENT_DATE,ACTIVE_PLAYERS,REVENUE_USD
DATA_DESTINATION_SCHEMA=UNITY_DATA.PORTAL_SHARING
PROVIDER_NAMESPACE=UNITY_PORTAL
# live-test only (all required). Creates DRAFT private listings targeting the entered account (must be a real account). Credentials are read from ~/.snowflake/connections.toml, never from here.
SNOWFLAKE_CONNECTION_NAME=MainAnthonyAccount
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=DEMO_WH
LISTING_TERMS=STANDARD
# Optional: approved provider profile name (SHOW PROFILES IN DATA EXCHANGE SNOWFLAKE_DATA_MARKETPLACE) and docs link.
LISTING_PROFILE=
LISTING_DOCUMENTATION_URL=https://docs.unity.com/
